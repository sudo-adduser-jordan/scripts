#!/bin/sh
set -eu

WAN_DEV="eth0"                  # Internet-input port
LAN_DEVS="eth1"                 # LAN ports, space-separated; exclude WAN
COUNTRY="US"                    # Change to your regulatory country code
SSID="router"
KEY=""

# Back up configuration before making changes.
# cp /etc/config/network /etc/config/network.backup
# cp /etc/config/wireless /etc/config/wireless.backup
# cp /etc/config/firewall /etc/config/firewall.backup

# Install driver, firmware, and full WPA supplicant/AP support.
# Use only packages built for this exact firmware/kernel.
if command -v apk >/dev/null 2>&1; then
    apk update
    apk add kmod-iwlwifi iwlwifi-firmware-iwl7265 wpad-openssl luci-theme-bootstrap
elif command -v opkg >/dev/null 2>&1; then
    opkg update
    opkg install kmod-iwlwifi iwlwifi-firmware-iwl7265 wpad-openssl luci-theme-bootstrap
fi

# Wired WAN gets an address from the upstream router/modem.
uci set network.wan='interface'
uci set network.wan.proto='dhcp'
uci set network.wan.device="$WAN_DEV"

# Bridge the selected Ethernet LAN ports with Wi-Fi on the LAN subnet.
uci set network.br_lan='device'
uci set network.br_lan.name='br-lan'
uci set network.br_lan.type='bridge'
uci -q delete network.br_lan.ports || true
for dev in $LAN_DEVS; do
    uci add_list network.br_lan.ports="$dev"
done

uci set network.lan='interface'
uci set network.lan.proto='static'
uci set network.lan.device='br-lan'
uci set network.lan.ipaddr='192.168.8.1'
uci set network.lan.netmask='255.255.255.0'

# Configure the Intel card as a 2.4 GHz AP.
uci set wireless.radio0.country="$COUNTRY"
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.band='2g'
uci set wireless.radio0.channel='6'

AP="$(uci add wireless wifi-iface)"
uci set "wireless.$AP.device=radio0"
uci set "wireless.$AP.mode=ap"
uci set "wireless.$AP.network=lan"
uci set "wireless.$AP.ssid=$SSID"
uci set "wireless.$AP.encryption=psk2"
uci set "wireless.$AP.key=$KEY"

uci commit network
uci commit wireless

/etc/init.d/network restart
wifi reload

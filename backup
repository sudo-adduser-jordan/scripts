#!/bin/bash
LIST="repositories.txt"

gh auth status || exit 1
gh api --paginate /user/repos --jq '.[].full_name' | tee "$LIST"

echo

while read -r REPOSITORY
do
    DIR="${REPOSITORY##*/}"
    if [ -d "$DIR/.git" ]; then
        echo "$(pwd)/$DIR"
        git -C "$DIR" pull
    else
        gh repo clone "$REPOSITORY"
    fi
    echo
done < "$LIST"

if [ "$(basename "$PWD")" = "GitHub" ]; then
    for DIRECTORY in */; do
        REPOSITORY="${DIRECTORY%/}"
        if ! grep -Fxq "$REPOSITORY" <(awk -F/ '{print $NF}' "$LIST"); then
            rm -rfv "$REPOSITORY"
        fi
    done
    rm -fv "$LIST"
fi

